# 이 파일을 .env 로 복사해서 키를 채우세요. (.env 는 절대 git에 올리지 마세요)
# 쓰고 싶은 AI 키만 넣으면 됩니다.

# Claude Code 가 설치돼 있으면 키 없이 자동 사용 (claudecode). 아래는 API 직접 호출용.
# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI — https://platform.openai.com
OPENAI_API_KEY=
# Google Gemini (무료 요금제 있음) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: Mistral (무료 체험 요금제) / Groq / xAI(Grok) — 최종 승인 다른 AI 자리에 쓰임
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# FreeLLMAPI (선택) — 무료 AI(Google, Groq 등)를 묶은 중계기. 중간 검토자 '다른 AI' 자리에만 쓰임.
#   Claude Code 설정은 건드리지 않아요. 주소는 루트만 (뒤에 /v1 붙이지 마세요)
FREELLM_URL=
FREELLM_API_KEY=
#   검토자 3자리에 쓸 모델 이름 (FreeLLMAPI 에 등록된 이름, 쉼표로). 비우면 auto
FREELLM_MODELS=
#   FreeLLMAPI 가 받는 방식: anthropic(기본, Claude Code 와 같은 방식) / openai
FREELLM_API=anthropic

# 로컬 실행기 주소 (기본값이면 비워두기)
LMSTUDIO_BASE_URL=
OLLAMA_BASE_URL=
LOCAL_BASE_URL=

# 에이전트에 모델이 지정 안 됐을 때 쓸 기본값 (제공자 또는 제공자:모델)
DEFAULT_MODEL=claudecode
# 제공자별 기본 모델 바꾸기 (새 모델 나오면 여기만 고치면 됨)
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_MODEL=mistral-small-latest

# 기존 도구용
GOOGLE_API_KEY=
YOUTUBE_API_KEY=
NOTION_API_KEY=
DATABASE_URL=
