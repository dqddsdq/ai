# 이 파일을 .env 로 복사해서 키를 채우세요. (.env 는 절대 git에 올리지 마세요)
# 쓰고 싶은 AI 키만 넣으면 됩니다.

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI — https://platform.openai.com
OPENAI_API_KEY=
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: Mistral / Groq / xAI(Grok)
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# 로컬 Ollama 주소 (기본값이면 비워두기)
OLLAMA_BASE_URL=

# 에이전트에 모델이 지정 안 됐을 때 쓸 기본값 (제공자 또는 제공자:모델)
DEFAULT_MODEL=claude
# 제공자별 기본 모델 바꾸기 (새 모델 나오면 여기만 고치면 됨)
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro

# 기존 도구용
GOOGLE_API_KEY=
YOUTUBE_API_KEY=
NOTION_API_KEY=
DATABASE_URL=
